# SARVSAKSHI local configuration
# Copy to .env at the repo root. Do not commit real secrets.

SARVSAKSHI_ENV=development
SARVSAKSHI_LOG_LEVEL=INFO
SARVSAKSHI_API_HOST=127.0.0.1
SARVSAKSHI_API_PORT=8000
SARVSAKSHI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Absolute or repo-relative path. Tables are created on startup. No seed data.
SARVSAKSHI_DATABASE_PATH=data/processed/sarvsakshi.db

# Copilot LLM is optional and isolated. Keep false for the MVP template path.
SARVSAKSHI_LLM_ENABLED=false
SARVSAKSHI_LLM_API_KEY=
SARVSAKSHI_LLM_MODEL=
